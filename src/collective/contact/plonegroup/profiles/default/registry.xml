<?xml version="1.0" encoding="utf-8"?>
<registry>

  <records interface="collective.contact.plonegroup.browser.settings.IContactPlonegroupConfig">
    </records>

  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/collective-contact-plonegroup"
  >
    <value key="enabled">True</value>
    <value key="csscompilation">++resource++collective.contact.plonegroup/plonegroup.css</value>
    <value key="jscompilation">++resource++collective.contact.plonegroup/plonegroup.js</value>
    <value key="depends">plone</value>
    <value key="load_async">False</value>
    <value key="load_defer">False</value>
  </records>

</registry>
