<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Plone Actions Tool"
        name="portal_actions"
>

  <object meta_type="CMF Action Category"
          name="user"
  >
    <object insert-before="preferences"
            meta_type="CMF Action"
            name="own-groups"
            i18n:domain="collective.contact.plonegroup"
    >
      <property name="title"
                i18n:translate=""
      >Own groups management</property>
      <property name="url_expr">string:${portal_url}/@@manage-own-groups-users</property>
      <property name="available_expr">portal/@@manage-own-groups-users/available</property>
      <property name="icon_expr">string:plone-group</property>
      <property name="permissions">
        <element value="List portal members" />
      </property>
      <property name="visible">False</property>
    </object>
  </object>

</object>
